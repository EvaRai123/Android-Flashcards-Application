<?xml version="1.0" encoding="utf-8"?>


    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ExtraText,MissingConstraints"
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/beautiful_gradient"
        android:padding="16dp"
        tools:context=".MainActivity">

    <!-- Add these EditTexts here: -->

    <!-- Add these EditTexts here: -->

    <EditText
        android:id="@+id/edit_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Question"
        android:padding="12dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="Autofill,HardcodedText,TextContrastCheck,TextFields,TouchTargetSizeCheck,VisualLintOverlap,VisualLintTextFieldSize" />

    <EditText
        android:id="@+id/edit_answer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Enter Answer"
        android:padding="12dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_question"
        tools:ignore="Autofill,HardcodedText,TextContrastCheck,TextFields,TouchTargetSizeCheck,VisualLintTextFieldSize" />

    <!-- Then your first button -->

    <Button
        android:id="@+id/add_flashcard_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:ignore="SpeakableTextPresentCheck,DuplicateClickableBoundsCheck,VisualLintOverlap"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="16dp" />
    ...



    <!-- Then your first button -->

    <Button
        android:id="@+id/add_flashcard_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:ignore="DuplicateIds,MissingConstraints,SpeakableTextPresentCheck,VisualLintOverlap"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="16dp" />
    ...

```
<Button
android:id="@+id/add_flashcard_button"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:text="Add Flashcard"
android:backgroundTint="@color/sunset_orange"
android:textColor="#3E2723"
android:padding="16dp"
android:layout_marginTop="0dp"
app:layout_constraintTop_toTopOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"
tools:ignore="DuplicateIds,HardcodedText,VisualLintButtonSize" />

<Button
android:id="@+id/show_flashcards_button"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:backgroundTint="@color/ocean_blue"
android:padding="16dp"
android:text="Show Flashcards"
android:textColor="@color/white"
android:layout_marginTop="20dp"
app:layout_constraintTop_toBottomOf="@id/add_flashcard_button"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"
tools:ignore="HardcodedText,TextContrastCheck,VisualLintButtonSize" />

<Button
android:id="@+id/toggle_theme_button"
android:layout_width="0dp"
