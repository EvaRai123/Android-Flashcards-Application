<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="@color/lavender_galaxy_midnight"
                android:endColor="@color/space_black"
                android:startColor="@color/lavender_galaxy_deep"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerColor="#331A2F6D"
                android:endColor="#00000000"
                android:startColor="#4D6A3CCF"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#1A2B0F4C"
                android:endColor="#00000000"
                android:startColor="#332D0E63"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
